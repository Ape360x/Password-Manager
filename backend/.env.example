# Copy this file to .env and fill in real values before running in anything
# beyond local, throwaway testing. Never commit the real .env file.

# Flask session-signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# JWT signing secret. Generate the same way as SECRET_KEY (use a DIFFERENT value).
JWT_SECRET_KEY=

# Server-side secret used to wrap the vault key inside the JWT.
# MUST be a urlsafe-base64 32-byte key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_WRAP_SECRET=

# Optional overrides
DATABASE_URL=sqlite:///vault.db
CORS_ORIGINS=http://localhost:5173
PBKDF2_ITERATIONS=600000
